//- Blank Metal: the Lemon deck with a bit of _M (components/_blank-metal.scss), included inside the hello stack. The label carries a data-id, so it holds still while the logo shrinks into the ink panel and the white side slides in.
section.bm.bm-hello(data-auto-animate)
  p.bm-label(data-id="BmLabel") Where I work
  +bmLogo()(data-id="BmLogo")
  p.bm-tagline.fragment Your new favorite AI engineering partner.
  aside.notes
    ul
      li AI-first development agency
      li Based in Minneapolis
      li Help companies build smarter, faster products
      li AI as a first-class part of the process, not a bolt-on

section.bm.bm-split(data-auto-animate)
  p.bm-label(data-id="BmLabel") Where I work
  +bmLogo()(data-id="BmLogo")
  .bm-content
    ul.bm-hands
      li.fragment Training &amp; Enablement
      li.fragment Minneapolis, Minnesota
      li.fragment AI-first
      li.fragment Anthropic preferred partner
  aside.notes
    ul
      li Training and enablement, AI-first
      li Actively solving real problems for clients

//- "Serious professional": the line holds its data-id while the next slide swaps in something absurd, and auto-animate drops it onto the caption strip.
section.bm.bm-split(data-auto-animate)
  p.bm-label(data-id="BmLabel") Where I work
  +bmLogo()(data-id="BmLogo")
  .bm-content
    p.bm-role Front End Tech Lead
    h2(data-id="SeriousProfessional") I am a serious professional.
  aside.notes
    ul
      li Setup: "I am a serious professional."

section.over-media(data-auto-animate data-background-image="img/gif/shooty-frooty.gif" data-background-size="contain")
  h2(data-id="SeriousProfessional") I am a serious professional.
  aside.notes
    ul
      li Punchline.
