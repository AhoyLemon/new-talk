//- CODE: framed blocks, highlight steps, huge one-liners, side by side, and builds across slides.

section(data-spine="Code")

  section#CatalogueCode.divider
    h2 Code
    p Framed, numbered, stepped and built.
    p components/_code.scss, js/line-numbers.js

  section(data-spine-section="Blocks")
    h3 A labelled block, in steps
    pre(data-file="card.css")
      code.css(data-trim data-line-numbers="1-3|5-7").
        .card {
          container-type: inline-size;
        }

        .card h2 {
          font-size: clamp(1rem, 4cqi, 2rem);
        }
    aside.notes
      ul
        li pre(data-file) draws the filename tab. data-line-numbers="1-3|5-7" steps the highlight. Every block gets line numbers from js/line-numbers.js.

  section
    h3 Two short blocks
    pre(data-file="index.html")
      code.html(data-trim).
        <article class="card">
          <h2>Hello</h2>
        </article>
    pre(data-file="card.css")
      code.css(data-trim).
        .card { padding: 1rem; }
    aside.notes
      ul
        li Two pre blocks stacked: keep each to a few lines.

  section.statement
    pre.huge
      code.css(data-trim).
        :has(> img)
    p.aside (one line, set huge)
    aside.notes
      ul
        li pre.huge for a single big line.

  section(data-spine-section="Side by side")
    h3 Two ways to centre a thing
    .grid(data-columns="2")
      .column
        h3 Flexbox
        p Two properties on the parent, one per axis.
        pre
          code.css(data-trim).
            .parent {
              display: flex;
              justify-content: center;
              align-items: center;
            }
      .column
        h3 Grid
        p One property does both axes.
        pre
          code.css(data-trim).
            .parent {
              display: grid;
              place-items: center;
            }
    aside.notes
      ul
        li .grid(data-columns="2") with a .column each. components/_blocks.scss.


  section(data-auto-animate data-spine-section="Builds")
    h3 Sass had variables first
    pre(data-id="VariablesBuild")
      code.scss(data-trim).
        $brand: #ffe600;
    aside.notes
      ul
        li An auto-animate build: matching pre(data-id) on each slide.

  section(data-auto-animate)
    h3 Sass had variables first
    pre(data-id="VariablesBuild")
      code.scss(data-trim).
        $brand: #ffe600;

        .button {
          background: $brand;
        }

  section(data-auto-animate)
    h3 CSS has them now
    pre(data-id="VariablesBuild")
      code.css(data-trim).
        :root { --brand: #ffe600; }

        .button {
          background: var(--brand);
        }
