    path(d="M165.44,64.71v-24.38h51.78v24.38h-51.78Z")
    path(d="M249.13,64.71v-28.37h-12.77V11.51h51.78v24.82h-12.77v28.37h-26.24Z")
    path(d="M378.22,64.71V11.51h26.24v28.37h25.53v24.83h-51.78Z")
    path.bm-accent-a(d="M298.43,64.69l30.14-54.4,30.14,54.4h-60.29Z")
    path.bm-accent-i(d="M378.22,64.71V11.51h26.24v53.2h-26.24Z")
