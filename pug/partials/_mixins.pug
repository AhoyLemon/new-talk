mixin link(url)
  a(href=url target="_blank")
    span
      block

mixin image(file)
  figure
    - let imgSrc
    if file.includes("http")
      - imgSrc = file
    else
      - imgSrc = "img/"+file
    img(src=imgSrc)
    if block
      figcaption
        block


mixin videoBG(slug,start)
  if !start
    - start = 0
  section(data-background-iframe="https://www.youtube.com/embed/"+slug+"?start="+start+"&fs=0&showinfo=0&rel=0&modestbranding=1&autohide=1&showinfo=0&disablekb=1" data-background-interactive)&attributes(attributes)
    block

mixin introScreen(slug, start)
  +videoBG(slug,start)(class="over-media")&attributes(attributes)
    if talkTitle
      h3= talkTitle
    if subtitle
      p= subtitle
    p a talk by #{authorHandle}
    block

//- A live demo slide. The iframe keeps the demo's own CSS-pixel frame, since every demo is designed for exactly that viewport. The block carries the notes.
mixin demo(fileName, width = 1280, height = 600)
  section.demo(style=`--demo-w: ${width}; --demo-h: ${height};`)&attributes(attributes)
    iframe.demo-frame(src=`./demos/${fileName}` width=width height=height title=`Demo: ${fileName.replace(".html", "")}`)
    block

mixin iframe(url, width = 1280, height = 600)
  iframe.resizable(src=url width=width height=height)

//- A visual gag that still needs its real image, GIF or video. Deliberately loud so it can't ship by accident: swap the asset in as the slide's data-background and drop the mixin.
mixin gag(description)
  section.gag.over-media&attributes(attributes)
    .gag-placeholder
      p.gag-label Visual gag goes here
      p.gag-description= description
    block

//- Blank Metal's _M wordmark, drawn inline so CSS can light its two accents: the coral A and the magenta stem of the L, which spell "AI". Paths from the _M storybook's wordmark-color-on-dark.svg.
